SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set DB_ENGINE=mysql to use MySQL instead of the sqlite dev default
DB_ENGINE=sqlite
DB_NAME=skillsikka
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email. Leave EMAIL_HOST empty to print emails (OTPs) in the Django terminal.
# Mailtrap Email Testing (dev/staging, mail is caught in a Mailtrap inbox):
#   EMAIL_HOST=sandbox.smtp.mailtrap.io, EMAIL_PORT=2525,
#   user/password from the inbox's SMTP settings
# Mailtrap Email Sending (production, real delivery, needs a verified domain):
#   EMAIL_HOST=live.smtp.mailtrap.io, EMAIL_PORT=587, EMAIL_HOST_USER=api,
#   EMAIL_HOST_PASSWORD=<API token>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@skillsikka.com
